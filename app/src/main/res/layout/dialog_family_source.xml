<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="家庭配置"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_30"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:layout_marginBottom="@dimen/vs_15"
            android:text="选择配置来源，确认后自动重启加载"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/rowAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_8"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:padding="@dimen/vs_15"
            android:text="自动选择（推荐）\n依次尝试 GitHub → NAS → 电脑管家"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/rowGithub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_8"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:padding="@dimen/vs_15"
            android:text="GitHub 云端"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/rowNas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_8"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:padding="@dimen/vs_15"
            android:text="局域网 NAS"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/rowPc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_8"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:padding="@dimen/vs_15"
            android:text="电脑管家"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/rowEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:layout_marginBottom="@dimen/vs_8"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/vs_12"
            android:text="修改 NAS / 电脑地址"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/sourceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:text=""
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_10"
            android:text="取消"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</FrameLayout>
